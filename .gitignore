# OS cruft
.DS_Store

# Local Claude Code settings
.claude/settings.local.json

# fkit-managed local state — role settings, intake, tmp (re-created by fkit-claude-init.sh)
.fkit/

# Per-run Codex home dir (transient, machine-specific)
.codex-tmp/

# fkit-managed agents (refreshed by fkit-claude-init.sh)
.claude/agents/fkit-*.md

# fkit-managed skills (refreshed by fkit-claude-init.sh)
.claude/skills/fkit-*/

# Canonical native resources live in native/ and claude/; these are generated project copies.
.agents/agents/fkit-*.md
.agents/skills/fkit-*/
.agents/fkit-runtime/
