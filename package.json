{
  "name": "fkit",
  "version": "0.3.2",
  "scripts": {
    "test": "node --test test/*.test.js test/board/*.test.js",
    "test:unit": "node --test test/*.test.js test/board/*.test.js",
    "test:prove-red": "bash test/prove-red.sh",
    "test:docs": "node --test test/dual-home-parity.test.js test/task-id-uniqueness.test.js",
    "test:release": "node --test test/release/*.test.js",
    "board": "node bin/fkit-board.mjs",
    "generate:manifest": "node bin/generate-structure-manifest.mjs",
    "release": "node bin/release.mjs",
    "release:minor": "node bin/release.mjs --minor",
    "release:major": "node bin/release.mjs --major",
    "release:dry": "node bin/release.mjs --dry-run"
  },
  "description": "A Claude Code agent team for software projects: seven roles — lead, producer, coder, reviewer, adversarial-reviewer, architect, and wiki — in role-locked sessions with scoped skills, plus a project scaffold. Reviews get an independent second opinion from Codex.",
